 }
 
+/*
+ * Create a PL022 SPI controller with an m25p80 NOR flash on the virt machine.
+ * This exposes /dev/spidev0.0 to the guest for testing the userspace SPI driver.
+ */
+static void create_spi(const VirtMachineState *vms)
+{
+    char *nodename;
+    hwaddr base = vms->memmap[VIRT_SPI].base;
+    hwaddr size = vms->memmap[VIRT_SPI].size;
+    int irq = vms->irqmap[VIRT_SPI];
+    MachineState *ms = MACHINE(vms);
+    DeviceState *dev;
+    SysBusDevice *sbd;
+    BusState *spi_bus;
+
+    /* 1. Create PL022 SPI controller */
+    dev = qdev_new(TYPE_PL022);
+    sbd = SYS_BUS_DEVICE(dev);
+    sysbus_realize_and_unref(sbd, &error_fatal);
+    sysbus_mmio_map(sbd, 0, base);
+    sysbus_connect_irq(sbd, 0, qdev_get_gpio_in(vms->gic, irq));
+
+    /* 2. Attach n25q064 flash on CS0 (bound to spidev in DT, not m25p80 driver) */
+    spi_bus = qdev_get_child_bus(dev, "ssi");
+    {
+        DeviceState *flash_dev = qdev_new("n25q064");
+        qdev_realize_and_unref(flash_dev, spi_bus, &error_fatal);
+    }
+
+    /* 3. Generate device tree node */
+    nodename = g_strdup_printf("/spi@%" PRIx64, base);
+    qemu_fdt_add_subnode(ms->fdt, nodename);
+    {
+        const char compat[] = "arm,pl022\0arm,primecell";
+        qemu_fdt_setprop(ms->fdt, nodename, "compatible",
+                         compat, sizeof(compat));
+    }
+    qemu_fdt_setprop_sized_cells(ms->fdt, nodename, "reg",
+                                 2, base, 2, size);
+    qemu_fdt_setprop_cells(ms->fdt, nodename, "interrupts",
+                           gic_fdt_irq_type_spi(vms), irq,
+                           GIC_FDT_IRQ_FLAGS_LEVEL_HI);
+    qemu_fdt_setprop_cell(ms->fdt, nodename, "clocks", vms->clock_phandle);
+    qemu_fdt_setprop_string(ms->fdt, nodename, "clock-names", "apb_pclk");
+    qemu_fdt_setprop_cell(ms->fdt, nodename, "num-cs", 1);
+    qemu_fdt_setprop_cell(ms->fdt, nodename, "#address-cells", 1);
+    qemu_fdt_setprop_cell(ms->fdt, nodename, "#size-cells", 0);
+
+    /* spidev on CS0 for userspace access (/dev/spidevX.0) */
+    {
+        char *spidev_node = g_strdup_printf("/spi@%" PRIx64 "/spidev@0", base);
+        qemu_fdt_add_subnode(ms->fdt, spidev_node);
+        qemu_fdt_setprop_string(ms->fdt, spidev_node,
+                                "compatible", "rohm,dh2228fv");
+        qemu_fdt_setprop_cell(ms->fdt, spidev_node, "reg", 0);
+        qemu_fdt_setprop_cell(ms->fdt, spidev_node,
+                              "spi-max-frequency", 12000000);
+        g_free(spidev_node);
+    }
+
+    /* 4. Fix SPI bus number to 0 via /aliases/spi0, so the guest sees
+     *    /dev/spidev0.0 instead of a dynamically allocated bus (32766). */
+    qemu_fdt_setprop_string(ms->fdt, "/aliases", "spi0", nodename);
+
+    g_free(nodename);
+}
+
 static DeviceState *gpio_key_dev;
 static void virt_powerdown_req(Notifier *n, void *opaque)
 {
@@ -3316,6 +3387,7 @@ static void machvirt_init(MachineState *machine)
     create_rtc(vms);
 
     create_vfpga(vms);
+    create_spi(vms);
     create_i2c(vms);
 
     create_pcie(vms);
