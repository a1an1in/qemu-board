diff --git a/include/hw/misc/vfpga.h b/include/hw/misc/vfpga.h
new file mode 100644
index 0000000000..eceabd21b2
--- /dev/null
+++ b/include/hw/misc/vfpga.h
@@ -0,0 +1,45 @@
+/*
+ * Virtual FPGA (vfpga) emulation device for QEMU virt machine
+ *
+ * A simple FPGA-like device that:
+ *   - Provides a data register for read/write verification
+ *   - Provides an interrupt control register: writing bit0=1 raises the
+ *     IRQ line, writing bit0=0 clears it
+ *   - Exposes a single qemu_irq output that can be connected to a GIC SPI
+ *
+ * This is used to test the UIO (Userspace I/O) interrupt framework in a
+ * QEMU virt machine, where there is no real FPGA hardware.
+ *
+ * This code is licensed under the GPL.
+ */
+
+#ifndef HW_MISC_VFPGA_H
+#define HW_MISC_VFPGA_H
+
+#include "hw/core/sysbus.h"
+#include "qom/object.h"
+
+#define TYPE_VFPGA "vfpga"
+OBJECT_DECLARE_SIMPLE_TYPE(VfpgaState, VFPGA)
+
+/* Register offsets (relative to the MMIO base) */
+#define VFPGA_REG_IRQ_CTRL    0xFF0   /* irq control (W: bit0=1 raise, 0 clear) */
+#define VFPGA_REG_IRQ_STATUS  0xFF4   /* irq status (R: bit0 = pending) */
+
+/* Size of the generic data register array (0x00..0xFEC, supports 32/64-bit access) */
+#define VFPGA_REGS_SIZE       0xFF0
+
+struct VfpgaState {
+    /*< private >*/
+    SysBusDevice parent_obj;
+    /*< public >*/
+
+    MemoryRegion iomem;
+    qemu_irq irq;
+
+    uint32_t irq_pending;
+    /* Generic data registers covering 0x00..0xFEC */
+    uint8_t regs[VFPGA_REGS_SIZE];
+};
+
+#endif
