 };
 
 static void create_randomness(MachineState *ms, const char *node)
@@ -1576,6 +1579,32 @@ static void create_rtc(const VirtMachineState *vms)
     g_free(nodename);
 }
 
+static void create_vfpga(const VirtMachineState *vms)
+{
+    char *nodename;
+    hwaddr base = vms->memmap[VIRT_FPGA].base;
+    hwaddr size = vms->memmap[VIRT_FPGA].size;
+    int irq = vms->irqmap[VIRT_FPGA];
+    const char compat[] = "generic-uio";
+    MachineState *ms = MACHINE(vms);
+    SysBusDevice *s;
+
+    s = SYS_BUS_DEVICE(qdev_new(TYPE_VFPGA));
+    sysbus_realize_and_unref(s, &error_fatal);
+    sysbus_mmio_map(s, 0, base);
+    sysbus_connect_irq(s, 0, qdev_get_gpio_in(vms->gic, irq));
+
+    nodename = g_strdup_printf("/fpga@%" PRIx64, base);
+    qemu_fdt_add_subnode(ms->fdt, nodename);
+    qemu_fdt_setprop(ms->fdt, nodename, "compatible", compat, sizeof(compat));
+    qemu_fdt_setprop_sized_cells(ms->fdt, nodename, "reg",
+                                 2, base, 2, size);
+    qemu_fdt_setprop_cells(ms->fdt, nodename, "interrupts",
+                           gic_fdt_irq_type_spi(vms), irq,
+                           GIC_FDT_IRQ_FLAGS_LEVEL_HI);
+    g_free(nodename);
+}
+
 static DeviceState *gpio_key_dev;
 static void virt_powerdown_req(Notifier *n, void *opaque)
 {
@@ -3208,6 +3237,8 @@ static void machvirt_init(MachineState *machine)
 
     create_rtc(vms);
 
+    create_vfpga(vms);
+
     create_pcie(vms);
     create_cxl_host_reg_region(vms);
 
