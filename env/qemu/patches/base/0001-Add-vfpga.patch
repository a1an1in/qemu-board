diff --git a/hw/misc/vfpga.c b/hw/misc/vfpga.c
new file mode 100644
index 0000000000..a0f7a56202
--- /dev/null
+++ b/hw/misc/vfpga.c
@@ -0,0 +1,124 @@
+/*
+ * Virtual FPGA (vfpga) emulation device for QEMU virt machine
+ *
+ * A simple FPGA-like device that:
+ *   - Provides a data register for read/write verification
+ *   - Provides an interrupt control register: writing bit0=1 raises the
+ *     IRQ line, writing bit0=0 clears it
+ *   - Exposes a single qemu_irq output that can be connected to a GIC SPI
+ *
+ * This is used to test the UIO (Userspace I/O) interrupt framework in a
+ * QEMU virt machine, where there is no real FPGA hardware.
+ *
+ * This code is licensed under the GPL.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/misc/vfpga.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "qemu/bswap.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+
+static uint64_t vfpga_read(void *opaque, hwaddr offset, unsigned size)
+{
+    VfpgaState *s = VFPGA(opaque);
+
+    if (offset + size > 0x1000) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "vfpga_read: Bad offset 0x%" HWADDR_PRIx "\n",
+                      offset);
+        return 0;
+    }
+
+    switch (offset) {
+    case VFPGA_REG_IRQ_STATUS:
+        return s->irq_pending;
+    default:
+        /* Generic data register access (supports 32/64-bit) */
+        if (size == 8) {
+            return ldq_le_p(s->regs + offset);
+        } else {
+            return ldl_le_p(s->regs + offset);
+        }
+    }
+}
+
+static void vfpga_write(void *opaque, hwaddr offset,
+                        uint64_t value, unsigned size)
+{
+    VfpgaState *s = VFPGA(opaque);
+
+    if (offset + size > 0x1000) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "vfpga_write: Bad offset 0x%" HWADDR_PRIx "\n",
+                      offset);
+        return;
+    }
+
+    switch (offset) {
+    case VFPGA_REG_IRQ_CTRL:
+        if (value & 1) {
+            /* Raise the IRQ line */
+            s->irq_pending = 1;
+            qemu_set_irq(s->irq, 1);
+        } else {
+            /* Clear the IRQ line */
+            s->irq_pending = 0;
+            qemu_set_irq(s->irq, 0);
+        }
+        break;
+    default:
+        /* Generic data register access (supports 32/64-bit) */
+        if (size == 8) {
+            stq_le_p(s->regs + offset, value);
+        } else {
+            stl_le_p(s->regs + offset, value);
+        }
+        break;
+    }
+}
+
+static const MemoryRegionOps vfpga_ops = {
+    .read = vfpga_read,
+    .write = vfpga_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+    .impl = {
+        .min_access_size = 4,
+        .max_access_size = 8,
+    },
+};
+
+static void vfpga_init(Object *obj)
+{
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+    VfpgaState *s = VFPGA(obj);
+
+    memory_region_init_io(&s->iomem, OBJECT(s), &vfpga_ops, s,
+                          "vfpga", 0x1000);
+    sysbus_init_mmio(sbd, &s->iomem);
+    sysbus_init_irq(sbd, &s->irq);
+}
+
+static void vfpga_class_init(ObjectClass *oc, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+
+    dc->desc = "Virtual FPGA emulation device";
+}
+
+static const TypeInfo vfpga_type_info = {
+    .name          = TYPE_VFPGA,
+    .parent        = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(VfpgaState),
+    .instance_init = vfpga_init,
+    .class_init    = vfpga_class_init,
+};
+
+static void vfpga_register_types(void)
+{
+    type_register_static(&vfpga_type_info);
+}
+
+type_init(vfpga_register_types)
